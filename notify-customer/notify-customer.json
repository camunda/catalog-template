{
  "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
  "name": "Notify customer",
  "id": "com.example.catalog.notify-customer",
  "description": "Send a templated notification to a customer.",
  "version": 1,
  "appliesTo": ["bpmn:ServiceTask"],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "icon": {
    "contents": "data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2218%22%20height%3D%2218%22%20viewBox%3D%220%200%2018%2018%22%3E%3Cpath%20fill%3D%22%23505562%22%20d%3D%22M2%204h14v10H2z%22%2F%3E%3C%2Fsvg%3E"
  },
  "properties": [
    {
      "label": "Recipient",
      "type": "String",
      "binding": {
        "type": "zeebe:input",
        "name": "recipient"
      },
      "constraints": {
        "notEmpty": true
      }
    },
    {
      "label": "Message",
      "type": "Text",
      "binding": {
        "type": "zeebe:input",
        "name": "message"
      }
    }
  ]
}
